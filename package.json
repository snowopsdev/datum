{
  "name": "datum",
  "private": true,
  "description": "SEO content pipeline built on Payload CMS — research, generate, and QA articles end to end",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snowopsdev/datum.git"
  },
  "bugs": {
    "url": "https://github.com/snowopsdev/datum/issues"
  },
  "homepage": "https://github.com/snowopsdev/datum#readme",
  "engines": {
    "node": ">=22.22.2"
  },
  "workspaces": [
    "cms",
    "pipeline"
  ],
  "scripts": {
    "dev": "npm run dev --workspace cms",
    "seed": "npm run seed --workspace cms",
    "pipeline:fetch": "npm run fetch --workspace pipeline --",
    "pipeline:run": "npm run run --workspace pipeline --",
    "pipeline:report": "npm run report --workspace pipeline --",
    "typecheck": "npm run typecheck --workspace cms && npm run typecheck --workspace pipeline",
    "lint": "npm run lint --workspace cms",
    "test": "npm run test --workspace pipeline && npm run test:int --workspace cms"
  }
}
