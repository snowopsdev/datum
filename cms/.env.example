DATABASE_URL=postgresql://datum:datum@127.0.0.1:5432/datum
# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=YOUR_SECRET_HERE
# Public origin used to build absolute canonical article URLs.
# Required in production; without it, canonical metadata is omitted (no localhost fallback).
SITE_URL=http://localhost:3000
# Local-dev only; used by npm run seed (default: datum-dev-password)
SEED_ADMIN_PASSWORD=
NODE_OPTIONS="--no-deprecation --no-experimental-strip-types"

# Next.js only loads cms/.env (never the root .env), so anything the admin UI
# calls at request time needs to be set here too, not just in the root .env
# used by the pipeline CLI. The admin reads exactly these at request time:
# MOCK_MODE, ANTHROPIC_API_KEY, OPENAI_API_KEY, AHREFS_API_KEY, AHREFS_COUNTRY,
# TARGET_DOMAIN, COMPETITOR_DOMAINS, PIPELINE_MODEL_*, BRAND_VOICE_EXTRACT_MODEL,
# SETUP_ASSIST_MODEL, WEBHOOK_URL, WEBHOOK_SECRET, and SITE_URL.
# See the root .env.example for what each does.
MOCK_MODE=true
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AHREFS_API_KEY=
# Country code for keyword and SERP queries (default: us)
AHREFS_COUNTRY=
# Fallbacks for the Workspace setup page (/admin/ops/setup/workspace), which
# wins when set. These are the .env.example placeholder domains and are
# treated as unset rather than real ones.
TARGET_DOMAIN=example.com
COMPETITOR_DOMAINS=competitor-a.com,competitor-b.com
PIPELINE_MODEL_GENERATE=
PIPELINE_MODEL_FACT_CHECK=
PIPELINE_MODEL_QUALITATIVE_REVIEW=
PIPELINE_MODEL_CLAIM_EXTRACTION=
PIPELINE_MODEL_INFORMATION_GAIN_JUDGE=
PIPELINE_MODEL_EVIDENCE_VERIFICATION=
PIPELINE_MODEL_EVIDENCE_CHECK=
BRAND_VOICE_EXTRACT_MODEL=
# Falls back to BRAND_VOICE_EXTRACT_MODEL when blank
SETUP_ASSIST_MODEL=
# Status-event webhooks. Fallbacks for the Webhooks global (/admin/globals/webhook-settings);
# nothing is delivered until both a URL and a secret resolve. See docs/operations.md.
#WEBHOOK_URL=
#WEBHOOK_SECRET=

# Dev only: skip the admin login form by signing in as the seeded admin (never honoured in production)
PAYLOAD_AUTO_LOGIN=false
# Optional: which user to auto-login as (default admin@datum.local)
PAYLOAD_AUTO_LOGIN_EMAIL=
