DATABASE_URL=postgresql://datum:datum@127.0.0.1:5432/datum
# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=YOUR_SECRET_HERE
# Local-dev only; used by npm run seed (default: datum-dev-password)
SEED_ADMIN_PASSWORD=
NODE_OPTIONS="--no-deprecation --no-experimental-strip-types"

# Next.js only loads cms/.env (never the root .env), so anything the admin UI
# calls at request time — brand-guide extraction, and these vars as fallbacks
# for the Models global — needs to be set here too, not just in the root .env
# used by the pipeline CLI. See the root .env.example for what each does.
MOCK_MODE=true
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
BRAND_VOICE_EXTRACT_MODEL=

# Dev only: skip the admin login form by signing in as the seeded admin (never honoured in production)
PAYLOAD_AUTO_LOGIN=false
# Optional: which user to auto-login as (default admin@datum.local)
PAYLOAD_AUTO_LOGIN_EMAIL=
