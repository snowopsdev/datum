{
  "name": "cms",
  "version": "1.0.0",
  "description": "Payload CMS app for Datum — templates, articles, and admin UI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snowopsdev/datum.git",
    "directory": "cms"
  },
  "bugs": {
    "url": "https://github.com/snowopsdev/datum/issues"
  },
  "homepage": "https://github.com/snowopsdev/datum#readme",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "jobs:run": "cross-env NODE_OPTIONS=--no-deprecation payload jobs:run --queue content --limit 1",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env DISABLE_DEV_PUSH=true NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@openai/codex-sdk": "0.152.1",
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "cross-env": "^10.1.0",
    "dotenv": "17.4.2",
    "graphql": "^16.8.1",
    "mammoth": "^1.12.1",
    "next": "16.3.2",
    "openai": "^7.5.0",
    "payload": "3.88.0",
    "pdf-parse": "^2.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.2",
    "jsdom": "30.0.1",
    "prettier": "^3.4.2",
    "tsx": "4.23.12",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.68.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
